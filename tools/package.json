{
  "name": "@rex0220/print-craft-authoring-tools",
  "version": "6.0.0",
  "description": "rex0220 印刷屋プラグイン（kintone）の設定 JSON を AI で作る・確かめるための tools（fields / record / normalize / preview / diff / version）",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "pcraft-authoring": "dist/cli.mjs"
  },
  "files": [
    "dist/**",
    "vendor/**",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/vendor.mjs && node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "gen-functions": "node scripts/gen-functions.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rex0220/print-craft-authoring.git",
    "directory": "tools"
  },
  "bugs": {
    "url": "https://github.com/rex0220/print-craft-authoring/issues"
  },
  "dependencies": {
    "happy-dom": "^20.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "plugin-config-kit": "file:../../../plugin-config-kit",
    "print-craft": "file:../../print-craft",
    "rexgrid": "file:../../../rexgrid",
    "typescript": "^7.0.2"
  }
}
