            "html": "<div class=\"rex0220-pcraft-page\">\n  <div class=\"pcraft-inv-header\">見積書</div>\n  <div class=\"pcraft-inv-info\">\n    <div class=\"pcraft-inv-left\">\n      <p>${ESC_HTML(宛名)} 御中</p><br>\n      <p class=\"pcraft-inv-estimate-amount\">見積金額:<span>${FVAL(合計)}</span></p>\n      <p class=\"pcraft-inv-validity\">見積の有効期限: ${DATE_ADD(見積日, 1, \"month\", \"YYYY年M月D日\")}</p>\n    </div>\n    <div class=\"pcraft-inv-right\">\n      <p>見積書番号: ${ESC_HTML(見積番号)}</p>\n      <p>発行日: ${DATE_FORMAT(見積日, \"YYYY年M月D日\")}</p>\n      <p>株式会社サンプル</p>\n      <p>${ESC_HTML(担当者)}</p>\n      <img class=\"pcraft-inv-seal\" width=\"250\" height=\"120\" src=\"data:image/svg+xml;charset=utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22250%22%20height%3D%22120%22%20viewBox%3D%220%200%20250%20120%22%3E%3Crect%20x%3D%2210%22%20y%3D%2210%22%20width%3D%22230%22%20height%3D%22100%22%20rx%3D%2220%22%20ry%3D%2220%22%20stroke%3D%22red%22%20stroke-width%3D%225%22%20fill%3D%22none%22%2F%3E%3Ctext%20x%3D%22125%22%20y%3D%2250%22%20font-size%3D%2234%22%20font-weight%3D%22bold%22%20text-anchor%3D%22middle%22%20fill%3D%22red%22%3E%E6%A0%AA%E5%BC%8F%E4%BC%9A%E7%A4%BE%3C%2Ftext%3E%3Ctext%20x%3D%22125%22%20y%3D%2290%22%20font-size%3D%2234%22%20font-weight%3D%22bold%22%20text-anchor%3D%22middle%22%20fill%3D%22red%22%3E%E3%82%B5%E3%83%B3%E3%83%97%E3%83%AB%3C%2Ftext%3E%3C%2Fsvg%3E\">\n    </div>\n  </div>\n  ##table##\n  <div class=\"pcraft-inv-summary-section\">\n    <div class=\"pcraft-inv-remarks-section\"><strong>備考:</strong><br><span>${REPLACE(ESC_HTML(備考), NEWLINE(), \"<br>\")}</span></div>\n    <div class=\"pcraft-inv-total-section\">\n      <table><tbody>\n        <tr><th>小計</th><td>${FVAL(小計)}</td></tr>\n        <tr><th>消費税 (10%)</th><td>${FVAL(消費税)}</td></tr>\n        <tr><th><strong>合計</strong></th><td><strong>${FVAL(合計)}</strong></td></tr>\n      </tbody></table>\n    </div>\n  </div>\n</div>",
