# 認証情報（KINTONE_BASE_URL / KINTONE_API_TOKEN / KINTONE_USERNAME / KINTONE_PASSWORD と PCRAFT_PLUGIN_ZIP）
.env
node_modules/
# record コマンドの出力（個人情報を含む）と preview の出力
records/
out/
# tools の開発用（tools/.gitignore も参照）
tools/dist/
tools/vendor/*.js
# 環境ごとの認証（environments.json の envFile。.env と同じくコミットしない）
env/
# 設定のダウンロードを置く場所（take がアプリのフォルダーへ移す）
inbox/
